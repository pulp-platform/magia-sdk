# Default Makefile for compiling and running a single test application using the Magia-SDK.
# 
# To use this, make sure you have run the setup_env.sh script in the "script" directory
# in the Magia-SDK repository, in order to set both MAGIA_SDK_HOME and MAGIA_RTL_DIR correctly.
# 
# You also need to run the sourceme.sh script in gvsoc to add the simulator's binary directory to
# your PATH enviroment variable.
#
# You also need to have a valid CMakeLists.txt file in the test directory, alongside the 
# include and src folders following the guidelines defined in the Magia-SDK's README. 
# 
# Make sure the TEST_NAME variable in the Cmake file is the same as the one defined in this file!

SHELL 					:= /bin/bash

TEST_NAME				?= test_helloworld

CURR_DIR				?= $(shell pwd)
BASE_NAME				?= $(shell basename $(CURR_DIR))
CMAKE_BUILDDIR  		?= $(CURR_DIR)/build
BIN_ABS_PATH			?= $(CMAKE_BUILDDIR)/bin
TEST_BUILD_BINARY_DIR 	?= $(CMAKE_BUILDDIR)/$(BASE_NAME)

tiles					?= 4
spatz					?= 1
pulp_cores				?= 8
eval					?= 1
target_platform 		?= magia
control_core    		?= CV32E40P
compiler				?= GCC_MULTILIB

platform 				?= gvsoc
GVRUN					?= gvrun

fast_sim				?= 0

clean:
	rm -rf build/

all:
	cd $(MAGIA_SDK_HOME) && \
	make build tiles=$(tiles) spatz=$(spatz) pulp_cores=$(pulp_cores) \
		 eval=$(eval) target_platform=$(target_platform) control_core=$(control_core) \
		 compiler=$(compiler) test_path=$(CURR_DIR) CURR_DIR=$(CURR_DIR) \
		 CMAKE_BUILDDIR=$(CMAKE_BUILDDIR) BIN_ABS_PATH=$(BIN_ABS_PATH) \
		 TEST_BUILD_BINARY_DIR=$(TEST_BUILD_BINARY_DIR)

run:
	cd $(MAGIA_SDK_HOME) && \
	make run tiles=$(tiles) platform=$(platform) CMAKE_BUILDDIR=$(CMAKE_BUILDDIR) \
		 GVRUN=$(GVRUN) BIN_ABS_PATH=$(BIN_ABS_PATH) test=$(TEST_NAME) target_platform=$(target_platform)

setup_platform:
ifeq ($(platform), rtl)
	cd $(MAGIA_SDK_HOME) && \
	make rtl-clean && \
	make MAGIA target_platform=$(target_platform) tiles=$(tiles) control_core=$(control_core)
else ifeq ($(platform), verilator)
	cd $(MAGIA_SDK_HOME) && \
	make rtl-clean platform=verilator && \
	make rtl-clean && \
	make MAGIA target_platform=$(target_platform) tiles=$(tiles) control_core=$(control_core) \
		 platform=verilator
else ifeq ($(platform), gvsoc)
	@echo 'WARNING: This platform setup assumes that you are using gvsoc installed inside the Magia-SDK repository.'
	cd $(MAGIA_SDK_HOME) && \
	make gvsoc tiles=$(tiles) spatz=$(spatz) target_platform=$(target_platform) pulp_cores=$(pulp_cores)
else
	$(error Unrecognized platform value (acceptable values: rtl, verilator, gvsoc))
endif



