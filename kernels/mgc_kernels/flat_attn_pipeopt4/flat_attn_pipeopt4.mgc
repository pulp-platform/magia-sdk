# Francesco Conti <f.conti@unibo.it>
#
# Flat-Attention kernel: flat_attn_pipeopt3 with the per-tile outputs of a Q block reduce-scattered along
# the mesh row (each tile sums, normalizes and stores Br / MESH_X_TILES rows) instead of tree-reduced into the first
# column.
# Compile (the kernel, its header include/mgc_flat_attn_pipeopt4.h and its test) with
#   mgc/.venv/bin/python mgc/mgcc.py kernels/mgc_kernels/flat_attn_pipeopt4/flat_attn_pipeopt4.mgc \
#       --header tests/magia/mgc/flat_attn_pipeopt4/include/test.h \
#       -o kernels/mgc_kernels/flat_attn_pipeopt4/src/mgc_flat_attn_pipeopt4.c \
#       --test tests/magia/mgc/flat_attn_pipeopt4/src/test.c

from mgc import *

S, D, P, H, QKS = sizes("SEQ_LENGTH", "EMBED_SIZE", "PROJ_SIZE", "NUM_HEADS", "QK_SCALE_FP16")  # kernel arguments
q_   = l2("q_inp",  (S, P),    fp16)
kt_  = l2("k_inp",  (P, S),    fp16)
v_   = l2("v_inp",  (S, P),    fp16)
o_   = l2("o_out",  (S, P),    fp16)
o_gold = l2("o_gold", (S, P),  fp16)  # golden

WAIT_MODE = define(WFE)
S_BLOCK_SIZE_Q  = define(512)
S_BLOCK_SIZE_KV = define(512)
# rows of the output block of a Q block owned by each tile of the row after the reduce-scatter (the rows of a Q
# block per tile must be a multiple of MESH_X_TILES)
ATT_RS = define("(((S_BLOCK_SIZE_Q + MESH_Y_TILES - 1) / MESH_Y_TILES) / MESH_X_TILES)")

# Implemented in src/kernels.c and called on the tile's CV32 core; unless noted, each call returns when its
# work is done.
# Fused Spatz kernels from kernels/ (the softmax scale 1/sqrt(PROJ_SIZE) is folded into the exp):
# spatz_rowmax: m[r] = max_c x[r, c]; spatz_rowmax_max: m[r] = max(max_c x[r, c], p[r]).
spatz_rowmax = l1_kernel("l1_rowmax_fp16_spatz", operands=("m:out", "x:in"), params=("x.shape[0]", "x.shape[1]"), executor=CORE)
spatz_rowmax_max = l1_kernel("l1_rowmax_max_fp16_spatz", operands=("m:out", "x:in", "p:in"), params=("x.shape[0]", "x.shape[1]"), executor=CORE)
# spatz_expminus_rowsum: y[r, c] = exp((x[r, c] - m[r]) / sqrt(PROJ_SIZE)), s[r] = sum_c y[r, c];
# spatz_expminus_rowsum_alpha: also a[r] = exp((a[r] - m[r]) / sqrt(PROJ_SIZE)) in place.
# The _start variants only launch Spatz and return, so that the CV32 core can drive the iDMA meanwhile;
# spatz_expminus_rowsum_wait(y, s) waits for them.
spatz_expminus_rowsum_start = l1_kernel("l1_expminus_rowsum_start_fp16_spatz", operands=("y:out", "s:out", "x:in", "m:in"), params=("x.shape[0]", "x.shape[1]"), executor=CORE)
spatz_expminus_rowsum_alpha_start = l1_kernel("l1_expminus_rowsum_alpha_start_fp16_spatz", operands=("y:out", "s:out", "a:inout", "x:in", "m:in"), params=("x.shape[0]", "x.shape[1]"), executor=CORE)
spatz_expminus_rowsum_wait = l1_kernel("l1_spatz_wait", operands=("y:out", "s:out"), params=(), executor=CORE)
# spatz_colsum_acc: s[c] += sum_{r >= 1} g[r, c]; spatz_colsum_acc_rescale: then p = a * p, s = p + s.
spatz_colsum_acc = l1_kernel("l1_colsum_acc_fp16_spatz", operands=("s:inout", "g:in"), params=("g.shape[0]", "g.shape[1]"), executor=CORE)
spatz_colsum_acc_rescale = l1_kernel("l1_colsum_acc_rescale_fp16_spatz", operands=("s:inout", "g:in", "p:inout", "a:in"), params=("g.shape[0]", "g.shape[1]"), executor=CORE)
# spatz_colmax: m[c] = max_r x[r, c] on Spatz.
spatz_colmax = l1_kernel("l1_colmax_fp16_spatz", operands=("m:out", "x:in"), params=("x.shape[0]", "x.shape[1]"), executor=CORE)
# spatz_rowscale: y[r, c] = x[r, c] * s[r], i.e. y = diag(s) x, on Spatz.
spatz_rowscale = l1_kernel("l1_rowscale_fp16_spatz", operands=("y:out", "x:in", "s:in"), params=("x.shape[0]", "x.shape[1]"), executor=CORE)
# spatz_rowslice_sum_div: reduce-scatter sum and normalization of the output, on the tile of column jj
# y[r, c] = (o[jj * R + r, c] + sum_{k != jj} g[k, r, c]) / s[jj * R + r], R = y.shape[0]
spatz_rowslice_sum_div = l1_kernel("l1_rowslice_sum_div_fp16_spatz", operands=("y:out", "o:in", "g:in", "s:in"), params=("g.shape[0]", "y.shape[0]", "y.shape[1]"), executor=CORE)

@kernel("mgc_flat_attn_pipeopt4", check=(o_, o_gold), tol=0x11)
def flat_attn_pipeopt4():

    """
    Parallel loop over the tiles of the mesh
    """
    for ii, jj in tiles():
        # split each Q block [S_BLOCK_SIZE_Q x P] over the mesh rows and each K/V block [S_BLOCK_SIZE_KV x P]
        # over the mesh columns
        tiles_i = ii.split(S_BLOCK_SIZE_Q)
        tiles_j = jj.split(S_BLOCK_SIZE_KV)

        s_block_size_q:  u16 = S_BLOCK_SIZE_Q
        s_block_size_kv: u16 = S_BLOCK_SIZE_KV
        s_block_nb_q:  u8 = S // S_BLOCK_SIZE_Q
        s_block_nb_kv: u8 = S // S_BLOCK_SIZE_KV

        q  = L1.multi_buffer(q_[tiles_i, :])
        kt = L1.multi_buffer(kt_[:, tiles_j])
        v  = L1.multi_buffer(v_[tiles_j, :])
        o  = L1.single_buffer(o_[tiles_i, :])
        attn = L1.multi_buffer((tiles_i, tiles_j), fp16)
        row_max = L1.multi_buffer((tiles_i,), fp16)
        row_sum = L1.multi_buffer((tiles_i,), fp16)

        # [MESH_X_TILES x Stile]: row maxima/sums of all the tiles of this row, gathered on tile (ii, 0). The
        # other tiles use only row 0, but allocate it whole so that the L1 layout is the same everywhere
        row_gather_buf = L1.single_buffer((MESH_X_TILES, tiles_i), fp16)
        # reduce-scatter of o: tile (ii, k) sends slice c [ATT_RS x P] of its o to o_rs_recv_buf[k] of
        # tile (ii, c), which sums the received slices and its own into o_rs and stores it
        o_rs_recv_buf = L1.single_buffer((MESH_X_TILES, ATT_RS, P), fp16)
        o_rs = L1.single_buffer(o_[0:ATT_RS, :])

        # one software pipeline over all the (Q block, K/V block) pairs, it = siq * s_block_nb_kv + sikv, so
        # that the first Q @ Kt of a Q block overlaps the softmax and Attn @ V of the previous one
        s_block_nb: u16 = s_block_nb_q * s_block_nb_kv

        # stages are encoded out-of-order to enable correct overlap
        for it in pipeline(s_block_nb, sync=GLOBAL):

            """
            STAGE 1: MATMUL Q @ Kt
            """

            with stage(1):

                # attn [Stile x Stile] = Q @ Kt
                jqk = redmule.enqueue(q[it], kt[it], attn[it], op=MATMUL)
                redmule.commit_start()

            """
            STAGE 3: MATMUL Attn @ V
            """

            with stage(3):

                # o [Stile x P] += attn [Stile x Stile] @ v [Stile x P]; the first K/V block of a Q block
                # initializes it, o = attn @ v
                jav = redmule.enqueue(attn[it], v[it], o, op=GEMM, uninit=it % s_block_nb_kv == 0)

                # from the second K/V block of a Q block on, rescale the output accumulator of the previous blocks
                # to the new max in-place
                if it % s_block_nb_kv > 0:
                    spatz_rowscale(o, o, row_max[it - 1])

                redmule.commit_start()

            """
            STAGE 2: SOFTMAX
            """

            with stage(2):

                # per-tile row max of attn [Stile x Stile] -> row_gather_buf[0, :] [Stile]; from the second K/V
                # block of a Q block on, keep the largest of the new row max and of the previous one
                if it % s_block_nb_kv > 0:
                    spatz_rowmax_max(row_gather_buf, attn[it], row_max[it - 1])
                else:
                    spatz_rowmax(row_gather_buf, attn[it])

                # FIXME: this row reduction could be optimized with flash-decoding
                # gather the row maxima of all the tiles of the row into row_gather_buf of the first-column tile
                if jj > 0:
                    idma.store(row_gather_buf.at(ii, 0)[jj, :], row_gather_buf[0, :]).wait()
                sync(ROW)

                # row max over the whole S dimension: row_max [Stile] = max over the rows of row_gather_buf
                # [MESH_X_TILES x Stile] on the first-column tile, then multicast to the other tiles of the row
                if jj==0:
                    spatz_colmax(row_max[it], row_gather_buf)
                    idma.store(row_max.row[it], row_max[it]).wait()
                sync(ROW)

                # start attn [Stile x Stile] = exp((attn - row_max [Stile]) / sqrt(P)) in place (row_max
                # broadcast along the columns), and its per-tile row sum -> row_sum [Stile]. From the second K/V
                # block on, also the rescaling factor exp((row_max[it - 1] - row_max[it]) / sqrt(P)), in place in
                # row_max[it - 1], which is no longer needed
                if it % s_block_nb_kv > 0:
                    spatz_expminus_rowsum_alpha_start(attn[it], row_sum[it], row_max[it - 1], attn[it], row_max[it])
                else:
                    spatz_expminus_rowsum_start(attn[it], row_sum[it], attn[it], row_max[it])

            """
            STAGE 0: LOAD, while Spatz computes the exp
            """

            with stage(0):
                # first row of the slice of Q / O and of K / V owned by this tile in the blocks of iteration it
                s_start_q:  u16 = (it // s_block_nb_kv) * s_block_size_q + tiles_i.start
                s_start_kv: u16 = (it % s_block_nb_kv) * s_block_size_kv + tiles_j.start

                # load Q (every iteration: the next Q block loads while the previous one is still in use), K and V
                # on the first column, first row and last row of tiles respectively, so that the three multicasts
                # start from different tiles; each tile's block is [Stile x P] (transposed for Kt)
                if jj==0:
                    eq = idma.load(q[it], q_[s_start_q:s_start_q + tiles_i.size, :])
                if ii==0:
                    ekt = idma.load(kt[it], kt_[:, s_start_kv:s_start_kv + tiles_j.size])
                if ii==MESH_Y_TILES - 1:
                    ev = idma.load(v[it], v_[s_start_kv:s_start_kv + tiles_j.size, :])
                if jj==0:
                    eq.wait()
                if ii==0:
                    ekt.wait()
                if ii==MESH_Y_TILES - 1:
                    ev.wait()

                # multicast them by binary trees (recursive doubling, square power-of-two mesh):
                # - Q along the rows from the first column
                # - Kt down the columns from the first row
                # - V up the columns from the last row
                # At each level, every tile that already holds the block pushes it to the tile `stride_mc`
                # further away, so a block reaches all MESH_X_TILES tiles in log2(MESH_X_TILES) levels, with one
                # transfer per tile per level, instead of MESH_X_TILES - 1 serialized pushes from the source.
                dv: u8 = MESH_Y_TILES - 1 - ii
                stride_mc: u8 = MESH_X_TILES // 2
                for lvl_mc in range(MESH_X_TILES):
                    if stride_mc > 0:
                        if jj % (2 * stride_mc) == 0:
                            eq_mc = idma.store(q.at(ii, jj + stride_mc)[it], q[it])
                        if ii % (2 * stride_mc) == 0:
                            ekt_mc = idma.store(kt.at(ii + stride_mc, jj)[it], kt[it])
                        if dv % (2 * stride_mc) == 0:
                            ev_mc = idma.store(v.at(ii - stride_mc, jj)[it], v[it])
                        if jj % (2 * stride_mc) == 0:
                            eq_mc.wait()
                        if ii % (2 * stride_mc) == 0:
                            ekt_mc.wait()
                        if dv % (2 * stride_mc) == 0:
                            ev_mc.wait()
                        sync(GLOBAL)
                        stride_mc = stride_mc // 2

            with stage(2):
                spatz_expminus_rowsum_wait(attn[it], row_sum[it])

                # gather the row sums into row_gather_buf[jj, :] on the first column
                if jj > 0:
                    idma.store(row_gather_buf.at(ii, 0)[jj, :], row_sum[it]).wait()
                sync(ROW)

                # row sum over the whole S dimension: row_sum [Stile] += sum over the rows jj > 0 of
                # row_gather_buf [MESH_X_TILES x Stile]; from the second K/V block on, also add the previous row
                # sum row_sum[it - 1], rescaled in place by the rescaling factor. Then multicast row_sum from
                # the first-column tile to the other tiles of the row.
                if jj==0:
                    if it % s_block_nb_kv > 0:
                        spatz_colsum_acc_rescale(row_sum[it], row_gather_buf, row_sum[it - 1], row_max[it - 1])
                    else:
                        spatz_colsum_acc(row_sum[it], row_gather_buf)
                    idma.store(row_sum.row[it], row_sum[it]).wait()
                sync(ROW)

            with stage(3):
                jav.wait()

                # last K/V block of a Q block: reduce-scatter o along the row; tile (ii, jj) owns rows
                # [jj * ATT_RS, (jj + 1) * ATT_RS) of the block. Each tile:
                # 1) sends each other slice of its o to its owner, starting from the next tile, so that in
                #    every round each tile receives a single slice
                # 2) sums its own slice with the received ones and normalizes it by the row sum over the
                #    whole S dimension (row-wise division)
                # 3) writes it back to o_
                if it % s_block_nb_kv == s_block_nb_kv - 1:
                    s_start_o: u16 = (it // s_block_nb_kv) * s_block_size_q + tiles_i.start + jj * ATT_RS
                    for d_rs in range(MESH_X_TILES - 1):
                        c_rs: u8 = (jj + d_rs + 1) % MESH_X_TILES
                        idma.store(o_rs_recv_buf.at(ii, c_rs)[jj, :, :], o[c_rs * ATT_RS:(c_rs + 1) * ATT_RS, :]).wait()
                    sync(ROW)
                    spatz_rowslice_sum_div(o_rs, o, o_rs_recv_buf, row_sum[it])
                    idma.store(o_[s_start_o:s_start_o + ATT_RS, :], o_rs).wait()

            with stage(1):
                jqk.wait()
