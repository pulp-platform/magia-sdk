#
# Flat-Attention kernel, O = softmax(Q @ Kt / sqrt(P)) @ V, without software pipelining: the Q blocks and,
# for each, the K/V blocks in plain loops.
# Compile (the kernel, its header include/mgc_flat_attn_naive.h and its test) with
#   mgc/.venv/bin/python mgc/mgcc.py kernels/mgc_kernels/flat_attn_naive/flat_attn_naive.mgc \
#       --header tests/magia/mgc/flat_attn_naive/include/test.h \
#       -o kernels/mgc_kernels/flat_attn_naive/src/mgc_flat_attn_naive.c \
#       --test tests/magia/mgc/flat_attn_naive/src/test.c

from mgc import *

S, D, P, H, QKS = sizes("SEQ_LENGTH", "EMBED_SIZE", "PROJ_SIZE", "NUM_HEADS", "QK_SCALE_FP16")  # kernel arguments
q_   = l2("q_inp",  (S, P),    fp16)
kt_  = l2("k_inp",  (P, S),    fp16)
v_   = l2("v_inp",  (S, P),    fp16)
o_   = l2("o_out",  (S, P),    fp16)
o_gold = l2("o_gold", (S, P),  fp16)  # golden

WAIT_MODE = define(WFE)
S_BLOCK_SIZE_Q  = define(512)
S_BLOCK_SIZE_KV = define(512)

# Implemented in src/kernels.c and called on the tile's CV32 core; each call returns when its work is done.
# memset_zero: y[:] = 0 on Spatz (vse16.v of a zeroed register).
memset_zero = l1_kernel("l1_memset_zero_fp16_spatz", operands=("y:out",), params=("y.size",), executor=CORE)
# copy: y[:] = x[:] on the CV32 core (32-bit loads/stores).
copy = l1_kernel("l1_copy_fp16", operands=("y:out", "x:in"), params=("x.size",), executor=CORE)
# spatz_scale_rsqrt_p: y[:] = x[:] * 1/sqrt(PROJ_SIZE) on Spatz (vfmul.vf, scalar broadcast).
spatz_scale_rsqrt_p = l1_kernel("l1_scale_rsqrt_p_fp16_spatz", operands=("y:out", "x:in"), params=("x.size",), executor=CORE)
# spatz_rowmax: m[r] = max_c x[r, c] on Spatz (reducemax kernel).
spatz_rowmax = l1_kernel("l1_rowmax_fp16_spatz", operands=("m:out", "x:in"), params=("x.shape[0]", "x.shape[1]"), executor=CORE)
# spatz_max: y[k] = max(a[k], b[k]) for k < b.size, on Spatz.
spatz_max = l1_kernel("l1_max_fp16_spatz", operands=("y:out", "a:in", "b:in"), params=("b.size",), executor=CORE)
# spatz_colmax: m[c] = max_r x[r, c] on Spatz.
spatz_colmax = l1_kernel("l1_colmax_fp16_spatz", operands=("m:out", "x:in"), params=("x.shape[0]", "x.shape[1]"), executor=CORE)
# spatz_rowsum: s[r] = sum_c x[r, c] on Spatz (reducesum kernel).
spatz_rowsum = l1_kernel("l1_rowsum_fp16_spatz", operands=("s:out", "x:in"), params=("x.shape[0]", "x.shape[1]"), executor=CORE)
# spatz_colsum: s[c] = sum_r x[r, c] on Spatz (reducesum kernel).
spatz_colsum = l1_kernel("l1_colsum_fp16_spatz", operands=("s:out", "x:in"), params=("x.shape[0]", "x.shape[1]"), executor=CORE)
# spatz_expminus: y[r, c] = exp(x[r, c] - m[r]) on Spatz.
spatz_expminus = l1_kernel("l1_expminus_fp16_spatz", operands=("y:out", "x:in", "m:in"), params=("x.shape[0]", "x.shape[1]"), executor=CORE)
# spatz_sub, spatz_exp, spatz_mul, spatz_add: element-wise y = a - b, y = exp(x), y = a * b, y = a + b on Spatz.
spatz_sub = l1_kernel("l1_sub_fp16_spatz", operands=("y:out", "a:in", "b:in"), params=("a.size",), executor=CORE)
spatz_exp = l1_kernel("l1_exp_fp16_spatz", operands=("y:out", "x:in"), params=("x.size",), executor=CORE)
spatz_mul = l1_kernel("l1_mul_fp16_spatz", operands=("y:out", "a:in", "b:in"), params=("a.size",), executor=CORE)
spatz_add = l1_kernel("l1_add_fp16_spatz", operands=("y:out", "a:in", "b:in"), params=("a.size",), executor=CORE)
# spatz_rowscale: y[r, c] = x[r, c] * s[r], i.e. y = diag(s) x, on Spatz.
spatz_rowscale = l1_kernel("l1_rowscale_fp16_spatz", operands=("y:out", "x:in", "s:in"), params=("x.shape[0]", "x.shape[1]"), executor=CORE)
# spatz_rowdiv: y[r, c] = x[r, c] / s[r], i.e. y = diag(s)^-1 x, on Spatz.
spatz_rowdiv = l1_kernel("l1_rowdiv_fp16_spatz", operands=("y:out", "x:in", "s:in"), params=("x.shape[0]", "x.shape[1]"), executor=CORE)

@kernel("mgc_flat_attn_naive", check=(o_, o_gold), tol=0x11, authors=["Francesco Conti <f.conti@unibo.it>"])
def flat_attn_naive():

    """
    Parallel loop over the tiles of the mesh
    """
    for ii, jj in tiles():
        # split each Q block [S_BLOCK_SIZE_Q x P] over the mesh rows and each K/V block [S_BLOCK_SIZE_KV x P]
        # over the mesh columns
        tiles_i = ii.split(S_BLOCK_SIZE_Q)
        tiles_j = jj.split(S_BLOCK_SIZE_KV)

        s_block_size_q:  u16 = S_BLOCK_SIZE_Q
        s_block_size_kv: u16 = S_BLOCK_SIZE_KV
        s_block_nb_q:  u8 = S // S_BLOCK_SIZE_Q
        s_block_nb_kv: u8 = S // S_BLOCK_SIZE_KV

        q  = L1.single_buffer(q_[tiles_i, :])
        kt = L1.single_buffer(kt_[:, tiles_j])
        v  = L1.single_buffer(v_[tiles_j, :])
        o  = L1.single_buffer(o_[tiles_i, :])
        attn = L1.single_buffer((tiles_i, tiles_j), fp16)
        row_max = L1.single_buffer((tiles_i,), fp16)
        row_max_prev = L1.single_buffer((tiles_i,), fp16)
        row_sum = L1.single_buffer((tiles_i,), fp16)
        row_sum_prev = L1.single_buffer((tiles_i,), fp16)

        # [MESH_X_TILES x Stile]: row maxima/sums of all the tiles of this row, gathered on tile (ii, 0). The
        # other tiles use only row 0, but allocate it whole so that the L1 layout is the same everywhere
        row_gather_buf = L1.single_buffer((MESH_X_TILES, tiles_i), fp16)
        # receive buffer for the tree reduction of o
        o_tree_recv_buf = L1.single_buffer((tiles_i, P), fp16)

        # sequential loop over the Q blocks
        for siq in range(s_block_nb_q):
            # first row of the slice of Q / O owned by this tile in Q block siq
            s_start_q: u16 = siq * s_block_size_q + tiles_i.start

            # the first-column tiles load Q and multicast it along the row (serialized pushes, inefficient);
            # each tile's block is [Stile x P]
            if jj==0:
                idma.load(q, q_[s_start_q:s_start_q + tiles_i.size, :]).wait()
                idma.store(q.row, q).wait()

            # reset the output accumulator o [Stile x P] for this Q block
            memset_zero(o)

            # sequential loop over the K/V blocks
            for sikv in range(s_block_nb_kv):

                """
                STAGE 0: LOAD
                """

                # first row of the slice of K / V owned by this tile in K/V block sikv
                s_start_kv: u16 = sikv * s_block_size_kv + tiles_j.start

                # the first-row tiles load K and V and multicast them down the column (serialized pushes,
                # inefficient); each tile's block is [Stile x P] (transposed for Kt)
                if ii==0:
                    idma.load(kt, kt_[:, s_start_kv:s_start_kv + tiles_j.size]).wait()
                    idma.store(kt.col, kt).wait()
                    idma.load(v, v_[s_start_kv:s_start_kv + tiles_j.size, :]).wait()
                    idma.store(v.col, v).wait()

                sync(GLOBAL)

                """
                STAGE 1: MATMUL Q @ Kt
                """

                # attn [Stile x Stile] = Q @ Kt
                j = redmule.enqueue(q, kt, attn, op=MATMUL)
                redmule.commit_start()
                j.wait()

                """
                STAGE 2: SOFTMAX
                """

                # attn [Stile x Stile] *= 1/sqrt(P), in place
                spatz_scale_rsqrt_p(attn, attn)

                # per-tile row max of attn [Stile x Stile] -> row_gather_buf[0, :] [Stile]
                spatz_rowmax(row_gather_buf, attn)

                # from the second K/V block on, keep the largest of the new row max and of the previous one
                if sikv > 0:
                    spatz_max(row_gather_buf, row_gather_buf, row_max_prev)

                # gather the row maxima of all the tiles of the row into row_gather_buf of the first-column tile
                if jj > 0:
                    idma.store(row_gather_buf.at(ii, 0)[jj, :], row_gather_buf[0, :]).wait()
                sync(ROW)

                # row max over the whole S dimension: row_max [Stile] = max over the rows of row_gather_buf
                # [MESH_X_TILES x Stile] on the first-column tile, then multicast to the other tiles of the row
                if jj==0:
                    spatz_colmax(row_max, row_gather_buf)
                    idma.store(row_max.row, row_max).wait()
                sync(ROW)

                # attn [Stile x Stile] = exp(attn - row_max [Stile]), in-place, with row_max broadcast along the columns
                spatz_expminus(attn, attn, row_max)

                # from the second K/V block on, rescaling factor exp(row_max_prev - row_max), in place in row_max_prev
                if sikv > 0:
                    spatz_sub(row_max_prev, row_max_prev, row_max)
                    spatz_exp(row_max_prev, row_max_prev)

                # per-tile row sum of attn [Stile x Stile], gathered into row_gather_buf[jj, :] of the
                # first-column tile (which computes its own directly into row_gather_buf[0, :])
                if jj==0:
                    spatz_rowsum(row_gather_buf, attn)
                else:
                    spatz_rowsum(row_sum, attn)
                    idma.store(row_gather_buf.at(ii, 0)[jj, :], row_sum).wait()
                sync(ROW)

                # row sum over the whole S dimension: row_sum [Stile] = sum over the rows of row_gather_buf
                # [MESH_X_TILES x Stile] on the first-column tile, then multicast to the other tiles of the row
                if jj==0:
                    spatz_colsum(row_sum, row_gather_buf)
                    # from the second K/V block on, add the previous row sum rescaled by exp(row_max_prev - row_max)
                    if sikv > 0:
                        spatz_mul(row_sum_prev, row_max_prev, row_sum_prev)
                        spatz_add(row_sum, row_sum_prev, row_sum)
                    idma.store(row_sum.row, row_sum).wait()
                sync(ROW)

                # rescale the output accumulator of the previous blocks to the new max in-place
                if sikv > 0:
                    spatz_rowscale(o, o, row_max_prev)

                """
                STAGE 3: MATMUL Attn @ V
                """

                # o [Stile x P] += attn [Stile x Stile] @ v [Stile x P]
                j = redmule.enqueue(attn, v, o, op=GEMM)
                redmule.commit_start()
                j.wait()

                # keep this block's row max and row sum for the online-softmax rescaling in the next K/V iteration
                copy(row_max_prev, row_max)
                copy(row_sum_prev, row_sum)

                # all the tiles of the column are done with kt and v before tile (0, jj) multicasts the next K/V block
                sync(COL)

            # normalize the output: o [Stile x P] = o / row_sum (row-wise), in place
            spatz_rowdiv(o, o, row_sum)

            # row-wise binary-tree reduction of o into tile (ii, 0), which writes it back to o_
            stride: u8 = 1
            for lvl in range(MESH_X_TILES):
                if stride < MESH_X_TILES:
                    if jj % (2 * stride) == stride:
                        idma.store(o_tree_recv_buf.at(ii, jj - stride)[:, :], o).wait()
                    sync(ROW)
                    if jj % (2 * stride) == 0 and jj + stride < MESH_X_TILES:
                        spatz_add(o, o, o_tree_recv_buf)
                    sync(ROW)
                    stride = stride * 2
            if jj==0:
                idma.store(o_[s_start_q:s_start_q + tiles_i.size, :], o).wait()
