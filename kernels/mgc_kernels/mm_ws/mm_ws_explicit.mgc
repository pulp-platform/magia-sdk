#
# Weight-static GEMM on the MAGIA mesh, with the schedule of tests/magia/mesh/mm_ws_2 written out
# statement by statement:
#
#     Z = X @ W + Y
#
# No test builds it: mgc/tests/test_mgc.py only checks that it compiles. The mm_ws_mgc test uses
# the pipelined version, mm_ws.mgc.

from mgc import *

M, N, K = sizes("M_SIZE", "N_SIZE", "K_SIZE")  # kernel arguments
X = l2("x_inp", (M, N), fp16)
W = l2("w_inp", (N, K), fp16)
Y = l2("y_inp", (M, K), fp16)  # bias in, result out
Z = l2("z_out", (M, K), fp16)  # golden

N_ITERATIONS = define(1)
WAIT_MODE = define(WFE)


@kernel("mgc_mm_ws", check=(Y, Z), tol=0x11)
def mm_ws():
    """
    Weight-static matrix multiplication on MAGIA used as a systolic array, with an explicit schedule.
    """
    for y_id, x_id in tiles():
        """
        1. Static weight data-tile dimensions: N is split over the mesh rows, K over the mesh columns.
        """
        tile_h = y_id.split(N)
        tile_w = x_id.split(K)

        """
        1a. M is split into `timeslots` blocks of t_size rows. t_start is the first timeslot in which this
        tile can compute an output block (2 after the mesh row above); t_end is the last active one, which
        only passes on the last block.
        """
        timeslots: u8 = 4
        t_size: u8 = M // timeslots
        t_start: u8 = y_id * 2
        t_end: u8 = t_start + timeslots
        total_timeslots: u8 = (MESH_Y_TILES - 1) * 2 + timeslots + 1

        """
        2. Static weight data-tile.
        """
        w = L1.single_buffer(W[tile_h, tile_w])

        """
        2a. Input data-tile multi-buffer.
        """
        x = L1.multi_buffer(X[0:t_size, tile_h], depth=3)

        """
        2b. Output data-tile multi-buffer (written by the tile above, or loaded from L2 on the
        top row).
        """
        y = L1.multi_buffer(Y[0:t_size, tile_w], depth=3)

        pt: u8 = 0

        """
        Repeat the kernel body N_ITERATIONS times.
        """
        for z in range(N_ITERATIONS):
            # timeslot -1: load the static weights and the first input block
            idma.load(w, W[tile_h, tile_w]).wait()

            idma.load(x[0], X[0:t_size, tile_h]).wait()

            sync(GLOBAL)

            """
            3. Cycle over the timeslots.
            """
            for t in range(total_timeslots):
                """
                3a. Outside [t_start, t_end], only join the timeslot barrier.
                """
                if t < t_start or t > t_end:
                    sync(GLOBAL)
                    continue

                """
                3b. Select correct buffer for current, previous and next timeslot
                """
                rotate(pt)

                """
                3c. Top mesh row: load the output block of the current timeslot from L2.
                """
                if y_id == 0 and t < t_end:
                    idma.load(y[pt], Y[pt * t_size:(pt + 1) * t_size, tile_w]).wait()

                """
                3d. Load the next input, push the previous output down (or to L2), compute
                the current output.
                """
                if pt < timeslots - 1:
                    ex = idma.load(x[pt + 1], X[(pt + 1) * t_size:(pt + 2) * t_size, tile_h])
                if pt > 0:
                    if y_id == MESH_Y_TILES - 1:
                        eo = idma.store(Y[(pt - 1) * t_size:pt * t_size, tile_w], y[pt - 1])
                    else:
                        eo = idma.store(y.at_rel(1, 0)[pt - 1], y[pt - 1])
                if pt < timeslots:
                    job = redmule.gemm(x[pt], w, y[pt])

                if pt < timeslots - 1:
                    ex.wait()
                if pt > 0:
                    eo.wait()
                if pt < timeslots:
                    job.wait()

                """
                3e. Barrier before the next timeslot.
                """
                pt = pt + 1
                sync(GLOBAL)
