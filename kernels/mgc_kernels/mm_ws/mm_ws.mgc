#
# Weight-static GEMM (Z = X @ W + Y) on the MAGIA mesh, as a systolic pipeline.
# Same algorithm as tests/magia/mesh/mm_ws_2; mm_ws_explicit.mgc is the hand-scheduled version.
# Compile (the kernel, its header include/mgc_mm_ws.h and its test) with
#   mgc/.venv/bin/python mgc/mgcc.py kernels/mgc_kernels/mm_ws/mm_ws.mgc \
#       --header tests/magia/mgc/mm_ws_mgc/include/test.h \
#       -o kernels/mgc_kernels/mm_ws/src/mgc_mm_ws.c \
#       --test tests/magia/mgc/mm_ws_mgc/src/test.c

from mgc import *

M, N, K = sizes("M_SIZE", "N_SIZE", "K_SIZE")  # kernel arguments
X = l2("x_inp", (M, N), fp16)
W = l2("w_inp", (N, K), fp16)
Y = l2("y_inp", (M, K), fp16)  # bias in, result out
Z = l2("z_out", (M, K), fp16)  # golden

N_ITERATIONS = define(1)
WAIT_MODE = define(WFE)


@kernel("mgc_mm_ws", check=(Y, Z), tol=0x11)
def mm_ws():
    """
    Weight-static matrix multiplication on MAGIA used as a systolic array. Each tile keeps a block of W
    in L1; blocks of output rows flow down the mesh columns, accumulating x @ w at each tile.
    """
    for y_id, x_id in tiles():
        """
        1. Static weight data-tile: N is split over the mesh rows, K over the mesh columns.
        """
        tile_h = y_id.split(N)
        tile_w = x_id.split(K)

        """
        1a. The M dimension is processed in timeslots. Row y_id of the mesh starts 2 time
        steps after the row above it (a block takes one step to compute, one to travel down).
        """
        timeslots: u8 = 4
        t_size: u8 = M // timeslots
        t_start: u8 = y_id * 2

        """
        2. L1 buffers: the static weights, and multi-buffers for the input and output blocks.
        """
        w = L1.single_buffer(W[tile_h, tile_w])
        x = L1.multi_buffer(X[0:t_size, tile_h], depth=2)
        y = L1.multi_buffer(Y[0:t_size, tile_w], depth=3)

        """
        Repeat the kernel body N_ITERATIONS times.
        """
        for z in range(N_ITERATIONS):
            idma.load(w, W[tile_h, tile_w]).wait()

            """
            3. Systolic pipeline over the output blocks: load the input block (and, on the top
            row, the bias block), accumulate, then pass the block to the tile below (the bottom
            row stores it to L2). A global barrier closes every time step.
            """
            for pt in systolic(timeslots, skew=t_start, sync=GLOBAL):
                # stage 0: load the blocks of timeslot pt, waited one step later
                with stage(0):
                    if y_id == 0:
                        ey = idma.load(y[pt], Y[pt * t_size:(pt + 1) * t_size, tile_w])
                    ex = idma.load(x[pt], X[pt * t_size:(pt + 1) * t_size, tile_h])
                # stage 2: pass the block of timeslot pt to the next tile (or store it)
                with stage(2):
                    if y_id == MESH_Y_TILES - 1:
                        es = idma.store(Y[pt * t_size:(pt + 1) * t_size, tile_w], y[pt])
                    else:
                        es = idma.store(y.at_rel(1, 0)[pt], y[pt])
                # stage 1: wait for the blocks of timeslot pt, then accumulate it
                with stage(1):
                    if y_id == 0:
                        ey.wait()
                    ex.wait()
                    j = redmule.enqueue(x[pt], w, y[pt], op=GEMM)
                    redmule.commit_start()
                # end of the step: wait for the store and the job issued above
                with stage(2):
                    es.wait()
                with stage(1):
                    j.wait()
