#
# mm_os.mgc written with the explicit (low-level) schedule instead of pipeline(): the prologue, the
# multi-buffer slots, the event rotation and the placement of the RedMulE enqueue / commit_start / wait steps are
# spelled out by hand. It is the 2-stage schedule (operands loaded in the stage of their RedMulE job, depth-2
# buffers), not the 3-stage one of mm_os.mgc. No test builds it: mgc/tests/test_mgc.py checks that it compiles to
# the same code as mm_os.mgc turned 2-stage, comments aside.

from mgc import *

M, N, K = sizes("M_SIZE", "N_SIZE", "K_SIZE")  # kernel arguments
X = l2("x_inp", (M, N), fp16)
W = l2("w_inp", (N, K), fp16)
Y = l2("y_inp", (M, K), fp16)  # bias in, result out
Z = l2("z_out", (M, K), fp16)  # golden

N_ITERATIONS = define(1)
T_SIZE = define(64)  # reduction (N) rows per timeslot, N_SIZE / T_SIZE timeslots
# Outer blocking: the output is processed in M_NB blocks of M_BLK rows in turn (M_NB must divide M_SIZE), so that
# the L1-resident output block of a tile is M_BLK / MESH_Y_TILES rows (M_NB = 1: the whole output at once)
M_NB = define(1)
M_BLK = define("(M_SIZE / M_NB)")
WAIT_MODE = define(WFE)


@kernel("mgc_mm_os", check=(Y, Z), tol=0x11, authors=["Francesco Conti <f.conti@unibo.it>"])
def mm_os():
    """
    Output-static matrix multiplication on MAGIA used as a systolic array, with transfers and jobs
    issued through the mglib layer (mg_idma / mg_redmule / mg_event).
    """
    for y_id, x_id in tiles():
        """
        0. Outer blocking: output rows [mb * M_BLK, (mb + 1) * M_BLK) in turn.
        """
        for mb in range(M_NB):
            """
            1. Static output data-tile dimensions. If M_BLK and K are not multiples of the number of
            mesh-tiles along their axis, the tiles on the right and lower borders of the mesh get smaller ones.
            """
            tile_h = y_id.split(M_BLK)
            tile_w = x_id.split(K)
            # first output row of this tile in the block
            m0: u32 = mb * M_BLK + tile_h.start

            """
            1a. The reduction dimension N is split into timeslots of t_size. L1 per buffer, in bytes:
            input (tile_h x t_size) * data_dim, weight (t_size x tile_w) * data_dim,
            output (tile_h x tile_w) * data_dim.
            """
            t_size: u16 = T_SIZE
            timeslots: u16 = N // t_size

            """
            2. Static output data-tile, resident in L1 for the whole block.
            """
            y = L1.single_buffer(Y[tile_h, tile_w])

            """
            2a. Input data-tile multi-buffer (double buffered over the timeslots).
            """
            x = L1.multi_buffer(X[tile_h, 0:t_size], depth=2)

            """
            2b. Weight data-tile multi-buffer (double buffered over the timeslots).
            """
            w = L1.multi_buffer(W[0:t_size, tile_w], depth=2)
            redmule_evt = redmule.events(2)

            """
            Repeat the kernel body N_ITERATIONS times.
            """
            for z in range(N_ITERATIONS):
                """
                3. Load the static output tile, then run the timeslots as a software pipeline:
                the operands of timeslot i+1 are prefetched while RedMulE computes timeslot i.
                """
                ey = idma.load(y, Y[m0:m0 + tile_h.size, tile_w])
                ex = idma.load(x[0], X[m0:m0 + tile_h.size, 0:t_size])
                ew = idma.load(w[0], W[0:t_size, tile_w])
                # program the first job while its operands are loaded, start it once they have landed
                redmule.enqueue(x[0], w[0], y, op=GEMM, event=redmule_evt[0])
                ex.wait()
                ew.wait()
                ey.wait()
                redmule.commit_start()

                """
                4. Per timeslot, overlap the loads and the job of the next timeslot with the
                current job. No inter-tile synchronization is needed.
                """
                for i in range(timeslots):
                    if i < timeslots - 1:
                        # prefetch the operands of the next timeslot and program its job meanwhile
                        ex = idma.load(x[i + 1], X[m0:m0 + tile_h.size, (i + 1) * t_size:(i + 2) * t_size])
                        ew = idma.load(w[i + 1], W[(i + 1) * t_size:(i + 2) * t_size, tile_w])
                        redmule.enqueue(x[i + 1], w[i + 1], y, op=GEMM, event=redmule_evt[i + 1])
                        # commit the next job once its operands have landed: it runs after the current one
                        ex.wait()
                        ew.wait()
                        redmule.commit_start()
                        # wait for the current job
                        redmule_evt[i].wait()
                    else:
                        # last timeslot: nothing to prefetch
                        redmule_evt[i].wait()

                """
                5. Store the output data-tile back to L2
                """
                idma.store(Y[m0:m0 + tile_h.size, tile_w], y).wait()
