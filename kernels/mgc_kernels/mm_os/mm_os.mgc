#
# Output-static GEMM (Z = X @ W + Y) on the MAGIA mesh: the mgc version of tests/magia/mesh/mm_os_mglib.
# Compile (the kernel, its header include/mgc_mm_os.h and its test) with
#   mgc/.venv/bin/python mgc/mgcc.py kernels/mgc_kernels/mm_os/mm_os.mgc \
#       --header tests/magia/mgc/mm_os_mgc/include/test.h \
#       -o kernels/mgc_kernels/mm_os/src/mgc_mm_os.c \
#       --test tests/magia/mgc/mm_os_mgc/src/test.c

from mgc import *

M, N, K = sizes("M_SIZE", "N_SIZE", "K_SIZE")  # kernel arguments
X = l2("x_inp", (M, N), fp16)
W = l2("w_inp", (N, K), fp16)
Y = l2("y_inp", (M, K), fp16)  # bias in, result out
Z = l2("z_out", (M, K), fp16)  # golden

N_ITERATIONS = define(1)
T_SIZE = define(64)  # reduction (N) rows per timeslot, N_SIZE / T_SIZE timeslots
# Outer blocking: the output is processed in M_NB blocks of M_BLK rows in turn (M_NB must divide M_SIZE), so that
# the L1-resident output block of a tile is M_BLK / MESH_Y_TILES rows (M_NB = 1: the whole output at once)
M_NB = define(1)
M_BLK = define("(M_SIZE / M_NB)")
WAIT_MODE = define(WFE)


@kernel("mgc_mm_os", check=(Y, Z), tol=0x11)
def mm_os():
    """
    Output-static matrix multiplication on MAGIA used as a systolic array, with transfers and jobs
    issued through the mglib layer (mg_idma / mg_redmule / mg_event).
    """
    for y_id, x_id in tiles():
        """
        0. Outer blocking: output rows [mb * M_BLK, (mb + 1) * M_BLK) in turn.
        """
        for mb in range(M_NB):
            """
            1. Static output data-tile dimensions. If M_BLK and K are not multiples of the number of
            mesh-tiles along their axis, the tiles on the right and lower borders of the mesh get smaller ones.
            """
            tile_h = y_id.split(M_BLK)
            tile_w = x_id.split(K)
            # first output row of this tile in the block
            m0: u32 = mb * M_BLK + tile_h.start

            """
            1a. The reduction dimension N is split into timeslots of t_size. L1 per buffer, in bytes:
            input (tile_h x t_size) * data_dim, weight (t_size x tile_w) * data_dim,
            output (tile_h x tile_w) * data_dim.
            """
            t_size: u16 = T_SIZE
            timeslots: u16 = N // t_size

            """
            2. Static output data-tile, resident in L1 for the whole block.
            """
            y = L1.single_buffer(Y[tile_h, tile_w])

            """
            2a. Input data-tile multi-buffer (triple buffered over the timeslots).
            """
            x = L1.multi_buffer(X[tile_h, 0:t_size], depth=3)

            """
            2b. Weight data-tile multi-buffer (triple buffered over the timeslots).
            """
            w = L1.multi_buffer(W[0:t_size, tile_w], depth=3)
            redmule_evt = redmule.events(2)

            """
            Repeat the kernel body N_ITERATIONS times.
            """
            for z in range(N_ITERATIONS):
                """
                3. Load the static output tile, then run the timeslots as a software pipeline:
                the operands of timeslot i+1 are prefetched while RedMulE computes timeslot i.
                """
                ey = idma.load(y, Y[m0:m0 + tile_h.size, tile_w])
                for i in pipeline(timeslots):
                    """
                    4. Software pipeline over the timeslots (no inter-tile synchronization needed):
                    - stage 0: load the input and weight data-tiles, queued in the iDMA while the
                      previous jobs run
                    - stage 1: program the RedMulE job, commit it once its operands have landed
                    - stage 2: wait for the job
                    """
                    with stage(0):
                        ex = idma.load(x[i], X[m0:m0 + tile_h.size, i * t_size:(i + 1) * t_size])
                        ew = idma.load(w[i], W[i * t_size:(i + 1) * t_size, tile_w])
                    with stage(1):
                        redmule.enqueue(x[i], w[i], y, op=GEMM, event=redmule_evt[i])
                        ex.wait()
                        ew.wait()
                        redmule.commit_start()
                    with stage(2):
                        redmule_evt[i].wait()

                """
                5. Store the output data-tile back to L2
                """
                idma.store(Y[m0:m0 + tile_h.size, tile_w], y).wait()
