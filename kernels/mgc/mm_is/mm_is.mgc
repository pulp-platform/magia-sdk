#
# Input-static GEMM (Z = X @ W + Y) on the MAGIA mesh, as a systolic pipeline.
# Same algorithm as tests/magia/mesh/mm_is_2.
# Compile (the kernel, its header include/mgc_mm_is.h and its test) with
#   mgc/.venv/bin/python mgc/mgcc.py kernels/mgc/mm_is/mm_is.mgc \
#       --header tests/magia/mgc/mm_is_mgc/include/test.h \
#       -o kernels/mgc/mm_is/src/mgc_mm_is.c \
#       --test tests/magia/mgc/mm_is_mgc/src/test.c

from mgc import *

M, N, K = sizes("M_SIZE", "N_SIZE", "K_SIZE")  # kernel arguments
X = l2("x_inp", (M, N), fp16)
W = l2("w_inp", (N, K), fp16)
Y = l2("y_inp", (M, K), fp16)  # bias in, result out
Z = l2("z_out", (M, K), fp16)  # golden

N_ITERATIONS = define(1)
WAIT_MODE = define(WFE)


@kernel("mgc_mm_is", check=(Y, Z), tol=0x11, authors=["Francesco Conti <f.conti@unibo.it>"])
def mm_is():
    """
    Matrix multiplication on MAGIA as an input-static systolic array: each tile keeps a block of X in L1, and
    blocks of output columns flow east along the mesh rows, accumulating x @ w at each tile.
    """
    for y_id, x_id in tiles():
        """
        1. Static input block: M is split over the mesh rows, N over the mesh columns.
        """
        tile_h = y_id.split(M)
        tile_w = x_id.split(N)

        """
        1a. The K dimension is processed in timeslots. Column x_id of the mesh starts 2 time
        steps after the column to its left.
        """
        timeslots: u8 = 4
        t_size: u8 = K // timeslots
        t_start: u8 = x_id * 2

        """
        2. L1 buffers: the static inputs, and multi-buffers for the weight and output blocks.
        """
        x = L1.single_buffer(X[tile_h, tile_w])
        w = L1.multi_buffer(W[tile_w, 0:t_size], depth=2)
        y = L1.multi_buffer(Y[tile_h, 0:t_size], depth=3)

        """
        Repeat the kernel body N_ITERATIONS times.
        """
        for z in range(N_ITERATIONS):
            idma.load(x, X[tile_h, tile_w]).wait()

            """
            3. Systolic pipeline over the output blocks: load the weight block (and, on the left
            column, the bias block), accumulate, then pass the block to the tile on the right
            (the right column stores it to L2). A row barrier closes every time step.
            """
            for pt in systolic(timeslots, skew=t_start, sync=ROW):
                # stage 0: load the blocks of timeslot pt, waited one step later
                with stage(0):
                    if x_id == 0:
                        ey = idma.load(y[pt], Y[tile_h, pt * t_size:(pt + 1) * t_size])
                    ew = idma.load(w[pt], W[tile_w, pt * t_size:(pt + 1) * t_size])
                # stage 2: pass the block of timeslot pt to the next tile (or store it)
                with stage(2):
                    if x_id == MESH_X_TILES - 1:
                        es = idma.store(Y[tile_h, pt * t_size:(pt + 1) * t_size], y[pt])
                    else:
                        es = idma.store(y.at_rel(0, 1)[pt], y[pt])
                # stage 1: wait for the blocks of timeslot pt, then accumulate it
                with stage(1):
                    if x_id == 0:
                        ey.wait()
                    ew.wait()
                    j = redmule.enqueue(x, w[pt], y[pt], op=GEMM)
                    redmule.commit_start()
                # end of the step: wait for the store and the job issued above
                with stage(2):
                    es.wait()
                with stage(1):
                    j.wait()
