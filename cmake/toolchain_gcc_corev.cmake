# CORE-V CV32E40P toolchain, with the Zfinx/Zhinxmin and Xcv extensions.
set(CMAKE_EXECUTABLE_SUFFIX ".elf")
set(CMAKE_SYSTEM_NAME Generic)
set(COREV_BIN "$ENV{COREV_ROOT}/bin")
if(NOT DEFINED ENV{COREV_ROOT})
    set(COREV_BIN "")
else()
    string(APPEND COREV_BIN "/")
endif()
set(CMAKE_C_COMPILER "${COREV_BIN}riscv32-corev-elf-gcc")
set(COMPILER_NAME riscv32-corev-elf-gcc)
set(CMAKE_CXX_COMPILER "${COREV_BIN}riscv32-corev-elf-g++")
set(CMAKE_ASM_COMPILER ${CMAKE_C_COMPILER})
set(CMAKE_OBJCOPY "${COREV_BIN}riscv32-corev-elf-objcopy")
set(CMAKE_OBJDUMP "${COREV_BIN}riscv32-corev-elf-objdump")
set(CMAKE_AR "${COREV_BIN}riscv32-corev-elf-ar")
