#
# 2-D convolution, CONV_K x CONV_K kernel (odd, default 3), stride CONV_S (default 1), zero padding
# CONV_PAD = (CONV_K - 1) / 2 ("same" at stride 1), no bias, as an im2col GEMM:
# Y[OH*OW x COUT] = im2col(X) [OH*OW x K*K*CIN] @ W [K*K*CIN x COUT], with the output CONV_OH x CONV_OW,
# OH = (H + 2 * PAD - K) / S + 1 (and OW the same). X is HWC in L2, unpadded; W has its rows in (ky, kx, ci) order;
# Y is HWC.
# Tile (ii, jj) owns the output rows tile_h (mesh rows) and the output channels tile_c (mesh columns),
# with its W block resident in L1. Its pixels go through a 4-stage pipeline, CONV_CP pixels of one output row at a
# time (the last block of a row of a column block of CONV_WB columns may be partial: built and multiplied whole, only
# its pixels inside the column block stored; chosen by gen_golden.py so that the buffers fit L1):
#   0. iDMA: the CONV_K input rows the output row needs (from row * CONV_S - CONV_PAD), in one 2-D transfer; at the top and bottom of the
#      image the window is clamped inside it, and the rows outside it are zeros in the im2col;
#   1. Spatz: the im2col block [CONV_CP x K*K*CIN] of the pixels, with the zero padding;
#   2. RedMulE: the output block [CONV_CP x tile_c] = im2col block @ W block (MATMUL);
#   3. iDMA: the output block to L2.
# All four run at once on consecutive blocks.
# conv_im2col with the im2col shared by the tiles of a mesh row (in src/kernels.c): each builds
# CONV_CP / MESH_X_TILES pixels of the block on its Spatz, in tasks of CONV_SHARE_CHUNK pixels, and multicasts each
# task's pixels to the others while Spatz builds the next ones. This needs the im2col block at the same L1 offset
# on every tile (declared first) and a row barrier at the end of every pipeline step (sync=ROW).
# Compile with
#   mgc/.venv/bin/python mgc/mgcc.py tests/magia/mgc/conv_im2col_opt/conv_im2col_opt.mgc \
#       -o tests/magia/mgc/conv_im2col_opt/src/test.c

from mgc import *

H, W, CIN, COUT, KS, PAD = sizes("CONV_H", "CONV_W", "CONV_CIN", "CONV_COUT", "CONV_K", "CONV_PAD")  # from include/test.h
S, OH, OW = sizes("CONV_S", "CONV_OH", "CONV_OW")  # stride, output rows and columns
ROW, KKC, HW, CP = sizes("CONV_ROW", "CONV_KKC", "CONV_HW", "CONV_CP")  # W * CIN, K * K * CIN, OH * OW, pixels per block
# outer blocking: the convolution runs on CONV_NB blocks of CONV_CB = COUT / CONV_NB output channels in turn, so that
# the weights resident in L1 are those of the tile's channels of a block (CONV_NB chosen by gen_golden.py, 1 if all
# the weights fit)
NB, CB = sizes("CONV_NB", "CONV_CB")
# blocking of the output columns: within a block of channels, CONV_WNB blocks of CONV_WB = OW / CONV_WNB columns in
# turn, each with only its input window in L1 (CONV_WIN = min((CONV_WB - 1) * CONV_S + CONV_K, W) columns of the
# CONV_K input rows, clamped inside the image); chosen by gen_golden.py before CONV_NB (1 if the whole rows fit)
WNB, WB, WIN = sizes("CONV_WNB", "CONV_WB", "CONV_WIN")
x_ = l2("x_inp", (H, ROW), fp16)      # input, HWC
w_ = l2("w_inp", (KKC, COUT), fp16)   # weights, rows in (ky, kx, ci) order
y_ = l2("y_out", (HW, COUT), fp16)    # output, HWC
y_gold = l2("y_gold", (HW, COUT), fp16)  # golden

WAIT_MODE = define(WFE)

# Implemented in src/kernels.c, on the tile's CV32 core:
# im2col_start: starts the im2col of the CONV_CP pixels of output row `row` from column x0 on Spatz
# (kernels/im2col), from the input rows that stage 0 loaded, of this tile's part of them, and returns;
# im2col_wait(col) builds the rest of the part and multicasts it to the other tiles of the row, then waits for all
im2col_start = l1_kernel("l1_im2col_start_fp16_spatz", operands=("col:out", "x:in"), params=(), args=("row", "x0"),
                         executor=CORE)
im2col_wait = l1_kernel("l1_im2col_wait", operands=("col:out",), params=(), executor=CORE)


@test("test_conv_im2col_opt", authors=["Francesco Conti <f.conti@unibo.it>"])
def main():
    """
    CONV_K x CONV_K convolution (padding (CONV_K - 1) / 2, stride CONV_S) as an im2col GEMM: per block of CONV_CP output pixels
    of a row, the input rows loaded by iDMA, the im2col built by Spatz and the GEMM on RedMulE with the resident
    weights, the output stored by iDMA, in a 4-stage pipeline.
    """
    for ii, jj in tiles():
        # outer blocking: the rest of the test, on output channels [cb * CONV_CB, (cb + 1) * CONV_CB) in turn
        for cb in range(NB):
            tile_h = ii.split(OH)
            tile_c = jj.split(CB)
            # first output channel of this tile in the block
            c0: u32 = cb * CB + tile_c.start

            col = L1.multi_buffer((CP, KKC), fp16)       # im2col block, first: the same L1 offset on every tile
            xin = L1.multi_buffer(x_[0:KS, 0:WIN * CIN]) # the input window of a block: CONV_K rows, CONV_WIN columns
            w   = L1.single_buffer(w_[:, tile_c])        # weights of the tile's output channels
            y   = L1.multi_buffer(y_[0:CP, tile_c])      # output block

            n_ch: u32 = (WB + CP - 1) // CP              # blocks per output row of a W block, the last one partial
            n_it: u32 = tile_h.size * n_ch

            idma.load(w, w_[:, c0:c0 + tile_c.size]).wait()

            # y_out is in the shared .bss, which tile 0 clears in its crt0 while the other tiles may already run:
            # no output store before every tile is in main
            sync(GLOBAL)

            for wb in range(WNB):
                # first output column of the W block, and first column of its input window (clamped as the rows)
                wx: u32 = wb * WB
                left: u32 = 0
                if wx * S >= PAD:
                    left = wx * S - PAD
                if left + WIN > W:
                    left = W - WIN

                """
                Block i of W block wb: output row tile_h.start + i / n_ch, columns wx + (i % n_ch) * CONV_CP onwards. In every step the
                transfers, the Spatz task and the RedMulE job of four consecutive blocks are started, then waited.
                """
                for i in pipeline(n_it, sync=ROW):
                    with stage(0):
                        r: u32 = (tile_h.start + i // n_ch) * S  # input row of ky = 0, + CONV_PAD
                        lo: u32 = 0
                        if r + PAD >= H:
                            lo = H - KS
                        elif r >= PAD:
                            lo = r - PAD
                        ex = idma.load(xin[i], x_[lo:lo + KS, left * CIN:left * CIN + WIN * CIN])
                    with stage(1):
                        im2col_start(col[i], xin[i], tile_h.start + i // n_ch, wx + (i % n_ch) * CP)
                    with stage(2):
                        j = redmule.matmul(col[i], w, y[i])
                    with stage(3):
                        # the pixels of the block inside the W block (the last block of a row may have fewer)
                        nv: u32 = WB - (i % n_ch) * CP
                        if nv > CP:
                            nv = CP
                        p0: u32 = (tile_h.start + i // n_ch) * OW + wx + (i % n_ch) * CP
                        es = idma.store(y_[p0:p0 + nv, c0:c0 + tile_c.size], y[i][0:nv, :])
                    with stage(0):
                        ex.wait()
                    with stage(1):
                        im2col_wait(col[i])
                    with stage(2):
                        j.wait()
                    with stage(3):
                        es.wait()

        # check the whole output on tile (0, 0), once every tile has written its blocks (after the blocks, so that the
        # check is not inside the measured window)
        sync(GLOBAL)
        if ii == 0:
            if jj == 0:
                check(y_[:, :], y_gold[:, :], tol=0x11)
