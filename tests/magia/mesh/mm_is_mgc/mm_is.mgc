#
# Input-static GEMM (Z = X @ W + Y) on the MAGIA mesh, as a systolic pipeline.
# Same algorithm as tests/magia/mesh/mm_is_mglib (the mglib port of mm_is_2).
# Compile with
#   mgc/.venv/bin/python mgc/mgcc.py tests/magia/mesh/mm_is_mgc/mm_is.mgc -o tests/magia/mesh/mm_is_mgc/src/test.c

from mgc import *

M, N, K = sizes("M_SIZE", "N_SIZE", "K_SIZE")  # from include/test.h
X = l2("x_inp", (M, N), fp16)
W = l2("w_inp", (N, K), fp16)
Y = l2("y_inp", (M, K), fp16)  # bias in, result out
Z = l2("z_out", (M, K), fp16)  # golden

N_ITERATIONS = define(1)
WAIT_MODE = define(WFE)


@test("test_mm_is_mgc", authors=["Francesco Conti <f.conti@unibo.it>"])
def main():
    """
    This test aims to verify the functionality of MAGIA as a systolic array for matrix
    multiplications, following the input-static mechanism. Each tile keeps a block of X in
    L1; blocks of output columns flow east along the mesh rows, accumulating x @ w at each
    tile.
    """
    for y_id, x_id in tiles():
        """
        1. Static input data-tile: M is split over the mesh rows, N over the mesh columns.
        """
        tile_h = y_id.split(M)
        tile_w = x_id.split(N)

        """
        1a. The K dimension is processed in timeslots. Column x_id of the mesh starts 2 time
        steps after the column to its left.
        """
        timeslots: u8 = 4
        t_size: u8 = K // timeslots
        t_start: u8 = x_id * 2
        total_timeslots: u8 = (MESH_X_TILES - 1) * 2 + timeslots + 1

        """
        2. L1 buffers: the static inputs, and multi-buffers for the weight and output blocks.
        """
        x = L1.alloc(X[tile_h, tile_w])
        w = L1.multi_buffer(W[tile_w, 0:t_size], depth=2)
        y = L1.multi_buffer(Y[tile_h, 0:t_size], depth=3)

        """
        TEST LOOP - REPEAT THE TEST N_ITERATION TIMES.
        """
        for z in range(N_ITERATIONS):
            dma.load(x, X[tile_h, tile_w]).wait()

            """
            3. Systolic pipeline over the output blocks: load the weight block (and, on the left
            column, the bias block), accumulate, then pass the block to the tile on the right
            (the right column stores it to L2). A row barrier closes every time step.
            """
            for pt in pipeline(timeslots, skew=t_start, steps=total_timeslots, sync=ROW):
                if x_id == 0:
                    dma.load(y[pt], Y[tile_h, pt * t_size:(pt + 1) * t_size])
                dma.load(w[pt], W[tile_w, pt * t_size:(pt + 1) * t_size])
                redmule.gemm(x, w[pt], y[pt])
                if x_id == MESH_X_TILES - 1:
                    dma.store(Y[tile_h, pt * t_size:(pt + 1) * t_size], y[pt])
                else:
                    dma.store(y.on(0, 1)[pt], y[pt])

        """
        4. Check results
        """
        sync(ROW)
        if x_id == MESH_X_TILES - 1:
            check(Y[tile_h, :], Z[tile_h, :], tol=0x11)
